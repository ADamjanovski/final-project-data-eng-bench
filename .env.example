# data-eng-bench environment variables. Copy to .env and fill in the values you need:
#   cp .env.example .env
#
# The DuckDB variant (DB_TYPE=duckdb, the default) uses local data.
# --- Langfuse trace output ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development

# --- Snowflake variant only (DB_TYPE=snowflake) ---
SNOWFLAKE_ACCOUNT=           # e.g. abcd-xy12345
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=          # or configure key-pair auth in ~/.snowflake/connections.toml
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=DBT_BENCH_RETAIL
SNOWFLAKE_ROLE=SYSADMIN
